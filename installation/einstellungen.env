# =============================================================================
#  EINSTELLUNGEN – nur diese Datei muss bearbeitet werden
# =============================================================================
#
#  So geht's:
#   1. Datei mit dem Editor öffnen (Windows: Rechtsklick → "Öffnen mit" → Editor,
#      Mac: Rechtsklick → "Öffnen mit" → TextEdit).
#   2. Bei ADMIN_PASSWORT den Text HIER_PASSWORT_EINTRAGEN durch ein eigenes
#      Passwort ersetzen. Keine Leerzeichen, keine Anführungszeichen.
#   3. Speichern. Der Dateiname muss genau "einstellungen.env" bleiben
#      (NICHT "einstellungen.env.txt").
#
#  Die Zeilen mit AUTOMATISCH füllt das Startprogramm beim ersten Start selbst
#  mit Zufallswerten. Bitte danach nicht mehr ändern – sonst findet Paperless
#  seine Datenbank nicht mehr.
# =============================================================================

# Ihr Benutzername und Passwort für die Paperless-Weboberfläche
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=HIER_PASSWORT_EINTRAGEN

# --- Ab hier nichts ändern ---------------------------------------------------
DB_PASSWORT=AUTOMATISCH
GEHEIMER_SCHLUESSEL=AUTOMATISCH
